flowchart LR
    classDef actor fill:#ffffff,stroke:#ffffff,color:#111827;
    classDef main fill:#dbeafe,stroke:#6b8fb8,stroke-width:1.8,color:#111827;
    classDef sub fill:#bfe8ea,stroke:#2b8c99,stroke-width:1.8,color:#111827;
    classDef alt fill:#fde2b8,stroke:#d28a1e,stroke-width:1.8,color:#111827;
    classDef auth fill:#d9f2d2,stroke:#7fb26e,stroke-width:1.8,color:#111827;
    classDef sec fill:#f8d7da,stroke:#c96b77,stroke-width:1.8,color:#111827;

    U[Utilisateur]:::actor
    A[Admin]:::actor

    Q([Poser une question]):::main
    R([Voir reponse]):::main
    SRC([Voir sources, chunks et citations]):::alt
    T([Utiliser la transcription]):::alt

    CADMIN([Interagir avec le chat admin intelligent]):::main
    INS([Executer une inspection]):::sub
    MUT([Executer une mutation]):::sub
    WF([Declencher un workflow multi-etapes]):::sub
    TOOLS([Consulter les outils et informations systeme]):::sub
    RAGREAD([Consulter les parametres RAG]):::sub
    RAGMUT([Modifier les parametres RAG]):::sub
    CHUNK([Modifier le chunking]):::sub
    RERANK([Modifier le reranking]):::sub
    GRAPH([Consulter le graphe d'orchestration]):::sub
    SYN([Voir reponse admin et synthese finale]):::alt

    SEC([Appliquer les controles de securite]):::sec
    AUTH([S'authentifier]):::auth

    U --> Q
    U --> R
    U --> T

    A --> CADMIN
    A --> SYN
    A --> T

    Q -. "<<include>>" .-> AUTH
    R -. "<<include>>" .-> AUTH
    CADMIN -. "<<include>>" .-> AUTH
    SYN -. "<<include>>" .-> AUTH

    T -. "<<extend>>" .-> Q
    T -. "<<extend>>" .-> CADMIN
    SRC -. "<<extend>>" .-> R

    CADMIN -. "<<uses>>" .-> INS
    CADMIN -. "<<uses>>" .-> MUT
    CADMIN -. "<<uses>>" .-> WF
    CADMIN -. "<<uses>>" .-> TOOLS
    CADMIN -. "<<uses>>" .-> RAGREAD
    CADMIN -. "<<uses>>" .-> GRAPH
    CADMIN -. "<<uses>>" .-> SYN

    INS -. "<<uses>>" .-> RAGREAD
    MUT -. "<<uses>>" .-> RAGMUT
    RAGMUT -. "<<uses>>" .-> CHUNK
    RAGMUT -. "<<uses>>" .-> RERANK

    MUT -. "<<include>>" .-> SEC
    WF -. "<<include>>" .-> SEC
    RAGMUT -. "<<include>>" .-> SEC
    GRAPH -. "<<include>>" .-> AUTH
    TOOLS -. "<<include>>" .-> AUTH
    INS -. "<<include>>" .-> AUTH
    MUT -. "<<include>>" .-> AUTH
    WF -. "<<include>>" .-> AUTH
    RAGREAD -. "<<include>>" .-> AUTH
