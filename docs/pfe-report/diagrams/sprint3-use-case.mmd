flowchart LR
    classDef actor fill:#ffffff,stroke:#ffffff,color:#111827;
    classDef main fill:#dbeafe,stroke:#6b8fb8,stroke-width:1.8,color:#111827;
    classDef sub fill:#bfe8ea,stroke:#2b8c99,stroke-width:1.8,color:#111827;
    classDef alt fill:#fde2b8,stroke:#d28a1e,stroke-width:1.8,color:#111827;
    classDef auth fill:#d9f2d2,stroke:#7fb26e,stroke-width:1.8,color:#111827;

    U[Utilisateur]:::actor
    A[Admin]:::actor

    Q([Poser une question]):::main
    R([Voir reponse et sources]):::main
    T([Utiliser la transcription]):::alt
    S([Maintenir la session]):::alt

    D([Consulter documents]):::main
    M([Voir metadonnees du document]):::sub
    C([Consulter apercus et citations]):::sub

    G([Gerer les utilisateurs]):::main
    U1([Inviter un utilisateur]):::sub
    U2([Valider un utilisateur]):::sub
    U3([Bloquer un utilisateur]):::sub
    U4([Supprimer un utilisateur]):::sub

    P([Interagir avec le prototype admin]):::main
    A1([Analyser une demande admin]):::sub
    A2([Traiter une demande recursive]):::sub
    A3([Traiter une demande frequente]):::sub
    A4([Fournir une reponse ou une orientation]):::sub

    AUTH([S'authentifier]):::auth

    U --> Q
    U --> R
    U --> T
    U --> S

    A --> D
    A --> G
    A --> P
    A --> T
    A --> S

    Q -. "<<include>>" .-> AUTH
    R -. "<<include>>" .-> AUTH
    D -. "<<include>>" .-> AUTH
    G -. "<<include>>" .-> AUTH
    P -. "<<include>>" .-> AUTH
    S -. "<<include>>" .-> AUTH

    T -. "<<extend>>" .-> Q
    T -. "<<extend>>" .-> P

    D -. "<<uses>>" .-> M
    D -. "<<uses>>" .-> C

    G -. "<<uses>>" .-> U1
    G -. "<<uses>>" .-> U2
    G -. "<<uses>>" .-> U3
    G -. "<<uses>>" .-> U4

    P -. "<<include>>" .-> A1
    A2 -. "<<extend>>" .-> A1
    A3 -. "<<extend>>" .-> A1
    P -. "<<uses>>" .-> A4
