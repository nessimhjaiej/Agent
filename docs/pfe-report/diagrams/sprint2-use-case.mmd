flowchart LR
    classDef actor fill:#ffffff,stroke:#ffffff,color:#111827;
    classDef usecase fill:#dbeafe,stroke:#6b8fb8,stroke-width:1.8,color:#111827;
    classDef boundary fill:#ffffff,stroke:#111827,stroke-width:1.2,color:#111827;

    U[Utilisateur]:::actor
    A[Admin]:::actor

    subgraph SYS["Sprint 2 - Synapse"]
        direction LR

        subgraph CHAT["Module conversationnel RAG"]
            direction TB
            AUTH([S'authentifier]):::usecase
            Q([Poser une question]):::usecase
            R([Voir reponse]):::usecase
            SRC([Voir sources et chunks recuperes]):::usecase
            SES([Maintenir la session]):::usecase
        end

        subgraph DOC["Module documentaire"]
            direction TB
            UP([Soumettre un document]):::usecase
            LIST([Consulter les documents]):::usecase
            META([Voir metadonnees du document]):::usecase
            UPLOADER([Voir l'uploader]):::usecase
            VAL([Valider un document]):::usecase
            REJ([Rejeter un document]):::usecase
            DEL([Supprimer un document]):::usecase
        end

        subgraph ADMIN["Module administration"]
            direction TB
            UM([Consulter les utilisateurs]):::usecase
            INV([Inviter un utilisateur]):::usecase
            ROLE([Gerer les acces et les roles]):::usecase
            SYNC([Synchroniser l'etat d'authentification]):::usecase
        end
    end

    U --> AUTH
    U --> Q
    U --> R
    U --> SES

    A --> AUTH
    A --> Q
    A --> R
    A --> UP
    A --> LIST
    A --> UM
    A --> INV
    A --> ROLE
    A --> SYNC

    Q -. "<<include>>" .-> AUTH
    R -. "<<include>>" .-> AUTH
    SES -. "<<include>>" .-> AUTH
    UP -. "<<include>>" .-> AUTH
    LIST -. "<<include>>" .-> AUTH
    UM -. "<<include>>" .-> AUTH
    INV -. "<<include>>" .-> AUTH
    ROLE -. "<<include>>" .-> AUTH
    SYNC -. "<<include>>" .-> AUTH

    SRC -. "<<extend>>" .-> R
    META -. "<<extend>>" .-> LIST
    UPLOADER -. "<<extend>>" .-> LIST
    VAL -. "<<extend>>" .-> LIST
    REJ -. "<<extend>>" .-> LIST
    DEL -. "<<extend>>" .-> LIST
    ROLE -. "<<extend>>" .-> UM
