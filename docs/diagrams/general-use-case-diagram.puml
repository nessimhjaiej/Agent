@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

title Agentic RAG Platform - General Use Case Diagram

actor Guest
actor "Authenticated User" as User
actor Administrator as Admin
actor "Supabase Auth / Storage" as Supabase
actor "OpenAI / Ollama" as LLM
actor Weaviate

rectangle "Agentic RAG Platform" {
  usecase "Sign up" as UC_SignUp
  usecase "Sign in" as UC_SignIn
  usecase "Manage account access" as UC_Access

  usecase "Ask grounded question" as UC_Ask
  usecase "View answer citations" as UC_Citations
  usecase "Use voice input" as UC_Voice
  usecase "Review chat history" as UC_History

  usecase "Upload document" as UC_Upload
  usecase "List documents" as UC_ListDocs
  usecase "Preview document" as UC_Preview

  usecase "Validate or reject document" as UC_Validate
  usecase "Index validated document" as UC_Index
  usecase "Delete document and chunks" as UC_DeleteDoc

  usecase "Ask admin copilot" as UC_AdminChat
  usecase "Review system status" as UC_Status
  usecase "Update retrieval configuration" as UC_Config
  usecase "Reindex corpus" as UC_Reindex
  usecase "Run RAG evaluation" as UC_Eval
  usecase "Restart backend services" as UC_Restart
  usecase "Manage users" as UC_Users

  usecase "Authenticate user" as UC_Auth
  usecase "Retrieve relevant chunks" as UC_Retrieve
  usecase "Generate grounded response" as UC_Generate
  usecase "Store files and metadata" as UC_Store
  usecase "Store and search vectors" as UC_Vector
}

Guest --> UC_SignUp
Guest --> UC_SignIn

User --> UC_Ask
User --> UC_Citations
User --> UC_Voice
User --> UC_History
User --> UC_Upload
User --> UC_ListDocs
User --> UC_Preview

Admin --> UC_Validate
Admin --> UC_Index
Admin --> UC_DeleteDoc
Admin --> UC_AdminChat
Admin --> UC_Status
Admin --> UC_Config
Admin --> UC_Reindex
Admin --> UC_Eval
Admin --> UC_Restart
Admin --> UC_Users
Admin --> UC_Access

UC_SignUp .> UC_Auth : <<include>>
UC_SignIn .> UC_Auth : <<include>>
UC_Access .> UC_Auth : <<include>>

UC_Ask .> UC_Retrieve : <<include>>
UC_Ask .> UC_Generate : <<include>>
UC_Citations .> UC_Ask : <<extend>>
UC_Voice .> UC_Ask : <<extend>>
UC_History .> UC_Ask : <<extend>>

UC_Upload .> UC_Store : <<include>>
UC_ListDocs .> UC_Store : <<include>>
UC_Preview .> UC_Store : <<include>>

UC_Validate .> UC_Store : <<include>>
UC_Index .> UC_Store : <<include>>
UC_Index .> UC_Vector : <<include>>
UC_DeleteDoc .> UC_Store : <<include>>
UC_DeleteDoc .> UC_Vector : <<include>>

UC_AdminChat .> UC_Status : <<extend>>
UC_AdminChat .> UC_Config : <<extend>>
UC_AdminChat .> UC_Reindex : <<extend>>
UC_AdminChat .> UC_Eval : <<extend>>
UC_AdminChat .> UC_Restart : <<extend>>

Supabase --> UC_Auth
Supabase --> UC_Store
LLM --> UC_Generate
Weaviate --> UC_Retrieve
Weaviate --> UC_Vector

@enduml
