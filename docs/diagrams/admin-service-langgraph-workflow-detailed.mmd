---
config:
  theme: base
  themeVariables:
    primaryColor: "#f5f3ff"
    primaryTextColor: "#1f2937"
    primaryBorderColor: "#7c3aed"
    lineColor: "#64748b"
    secondaryColor: "#ecfeff"
    tertiaryColor: "#fff7ed"
  flowchart:
    curve: linear
---
flowchart TD
  start([START])
  request[Admin chat request]
  classify[classify_intent_llm<br/>Classify request as advisory, inspect, or mutate]

  advisory[advisory_agent<br/>Answer conceptual questions<br/>Use read-only tools when helpful]
  inspect[inspect_agent<br/>Inspect live configuration, documents,<br/>reports, methods, and system state]
  mutate[mutate_executor<br/>Plan requested change<br/>Prepare pending action]

  confirm{Mutation needs<br/>admin confirmation?}
  rejected[Reject pending action]
  confirmed[Confirm pending action]
  execute[Execute approved tool or workflow]

  summarize[summarize_llm<br/>Finalize user-facing response<br/>Attach activity details]
  response[AdminChatResponse<br/>answer, mode, activity, pending_action, result]
  end([END])

  start --> request --> classify

  classify -. advisory .-> advisory
  classify -. inspect .-> inspect
  classify -. mutate .-> mutate

  advisory --> summarize
  inspect --> summarize
  mutate --> confirm

  confirm -- no --> summarize
  confirm -- yes --> response
  response -. admin rejects .-> rejected --> summarize
  response -. admin confirms .-> confirmed --> execute --> summarize

  summarize --> response --> end

  classDef terminal fill:#ede9fe,stroke:#6d28d9,stroke-width:2px,color:#111827
  classDef llm fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#111827
  classDef tool fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#111827
  classDef decision fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#111827
  classDef output fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#111827

  class start,end terminal
  class classify,advisory,inspect,summarize llm
  class mutate,rejected,confirmed,execute tool
  class confirm decision
  class request,response output
