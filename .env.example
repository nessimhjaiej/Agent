# Private service credentials only.
# Keep non-secret defaults in each service's app/config.py.

# OpenAI
OPENAI_KEY=your-openai-api-key

# Supabase
AUTH_SUPABASE_URL=https://your-project.supabase.co
AUTH_SUPABASE_KEY=your-supabase-service-role-key

# Frontend URL used in invitation and password reset links.
FRONTEND_URL=http://localhost:5173

# Shared document metadata/storage names.
VITE_SUPABASE_DOCS_BUCKET=documents
VITE_SUPABASE_DOCS_TABLE=documents

# Weaviate
WEAVIATE_COLLECTION=Chunk

# SMTP is optional and only needed for admin invitation email delivery.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=ICC Agent Admin
AUTH_SMTP_USE_TLS=true
