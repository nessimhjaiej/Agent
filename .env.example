# Preprocessing Service
PREPROCESSING_APP_NAME=preprocessing-service
PREPROCESSING_APP_VERSION=0.1.0
PREPROCESSING_CHUNK_STRATEGY=late
PREPROCESSING_CHUNK_SIZE=800
PREPROCESSING_CHUNK_OVERLAP=120
PREPROCESSING_PIPELINE_VERSION=v1
PREPROCESSING_RATE_LIMIT_REQUESTS=60
PREPROCESSING_RATE_LIMIT_WINDOW_SECONDS=60
PREPROCESSING_MAX_REQUEST_SIZE_BYTES=1048576

# Auth Service (Supabase Auth)
AUTH_APP_NAME=auth-service
AUTH_APP_VERSION=0.1.0
AUTH_SUPABASE_URL=https://your-project.supabase.co
AUTH_SUPABASE_KEY=your-supabase-service-role-or-anon-key
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24
AUTH_PASSWORD_MIN_LENGTH=8

# Embedding Service
EMBEDDING_APP_NAME=embedding-service
EMBEDDING_APP_VERSION=0.1.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=5
OPENAI_RETRY_BASE_SECONDS=1
WEAVIATE_HTTP_URL=http://localhost:8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=Chunk
WEAVIATE_BATCH_SIZE=100
WEAVIATE_STARTUP_TIMEOUT_SECONDS=20
WEAVIATE_FAIL_IF_COLLECTION_MISSING=true

